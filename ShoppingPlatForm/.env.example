# ══════════════════════════════════════════
# Shopverse — Environment Variables
# ══════════════════════════════════════════
# Copy this file to .env for local development.
# For Vercel, add these under Project → Settings → Environment Variables.
# NEVER commit .env to version control.

# ── Strongly recommended (the app still boots without them) ──
# Without JWT_SECRET a random one is generated per instance, which means
# users get logged out whenever a new lambda instance starts.
JWT_SECRET=paste-a-long-random-string-here-at-least-32-characters

# ── Optional ──
# Comma separated list of origins allowed to call the API. Leave blank when the
# frontend and API are served from the same Vercel domain (the default setup).
ALLOWED_ORIGIN=https://your-app.vercel.app

# Only needed outside Vercel.
PORT=5001

# Client (Vite)
# Only VITE_ prefixed vars are exposed to the browser — keep secrets out.
# Leave blank/unset: the client calls the API on the same origin.
# VITE_API_BASE_URL=
